{
  "name": "medical-system-frontend",
  "version": "1.0.0",
  "description": "医疗系统前端",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:mobile": "vite build --mode mobile",
    "mobile:build": "npm run build:mobile && npx cap sync",
    "android:run": "npx cap run android",
    "android:live": "npx cap run android -l --port 3000",
    "mobile:android": "npm run mobile:build && npx cap open android",
    "mobile:ios": "npm run mobile:build && npx cap open ios",
    "mobile:target:emulator": "powershell -ExecutionPolicy Bypass -File ./scripts/switch-mobile-target.ps1 -Target emulator",
    "mobile:target:device": "powershell -ExecutionPolicy Bypass -File ./scripts/switch-mobile-target.ps1 -Target device -DeviceIp 10.18.112.252",
    "mobile:fix:android": "powershell -ExecutionPolicy Bypass -File ./scripts/fix-android-compat.ps1",
    "test:navigation:report": "python ./scripts/navigation_test_report.py --cases 90"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "axios": "^1.5.0",
    "leaflet": "^1.9.4",
    "vue": "^3.3.4",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.3.4",
    "playwright": "^1.59.1",
    "vite": "^4.4.9"
  }
}
